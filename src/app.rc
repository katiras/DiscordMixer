#include "resource.h"
#include "version.h"
#include <windows.h>

IDI_APPICON ICON "../resources/app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VER_NUM
 PRODUCTVERSION APP_VER_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "katiras"
            VALUE "FileDescription",  "DiscordMixer"
            VALUE "FileVersion",      APP_VER_STR
            VALUE "InternalName",     "DiscordMixer"
            VALUE "OriginalFilename", "DiscordMixer.exe"
            VALUE "ProductName",      "DiscordMixer"
            VALUE "ProductVersion",   APP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
